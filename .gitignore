# OS and editor junk at the project root (frontend/ has its own .gitignore)
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea

# Secrets - nothing uses these today, but never commit them if added later
.env
.env.*
!.env.example

# Backend: virtual environment, logs, Python caches
backend/.venv/
backend/logs/
__pycache__/
.pytest_cache/

# AI coding tool files (downloaded skills, local Claude settings) - only needed on this laptop
.claude/
.agents/
skills-lock.json

# All markdown files (README, CLAUDE.md, build plans, notes) - kept on this laptop only
*.md

# Local data API leftovers: backups of the previous version and half-finished writes
frontend/data/*.backup.json
frontend/data/*.tmp

# Backend: database dumps (backup.ps1)
backend/backups/
