# Copy to backend/.env and fill in. .env is git-ignored; never commit it.
ENABLE_DOCS=true

# Sent as X-API-Key by the Vite proxy on every request. Generate with:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# PostgreSQL (localhost only). Generate each password with:
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(24))"
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plan_tracker
PLAN_APP_PASSWORD=
PLAN_OWNER_PASSWORD=
